{
  "name": "ssh-clipboard",
  "version": "0.2.10",
  "description": "Native, encrypted clipboard sync over SSH for macOS and Linux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standardagents/ssh-clipboard.git"
  },
  "homepage": "https://github.com/standardagents/ssh-clipboard#readme",
  "bugs": "https://github.com/standardagents/ssh-clipboard/issues",
  "type": "module",
  "bin": {
    "ssh-clipboard": "bin/ssh-clipboard.js"
  },
  "files": [
    "bin",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test npm-tests/*.test.mjs",
    "release": "node scripts/release.mjs",
    "release:dev": "node scripts/release.mjs --tag=dev",
    "release:nightly": "node scripts/release.mjs --tag=nightly",
    "stage:binaries": "node scripts/stage-npm-binaries.mjs",
    "version:check": "node scripts/check-version.mjs",
    "verify:binaries": "node scripts/verify-npm-binaries.mjs",
    "prepack": "npm run verify:binaries"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "clipboard",
    "ssh",
    "mosh",
    "tmux",
    "macos",
    "linux"
  ],
  "devDependencies": {
    "@clack/prompts": "^1.7.0"
  }
}
